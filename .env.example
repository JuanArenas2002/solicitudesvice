ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/solicitudes
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/solicitudes_test
# Minimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_LIFETIME_DAYS=30
# Cookie del refresh token (SPA y API deben compartir "site" con SameSite=strict)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
CORS_ORIGINS=["http://localhost:5173"]

# Soportes: <STORAGE_ROOT>/<cedula>/<producto>/Solicitud <N>/<archivo>
STORAGE_ROOT=storage
ATTACHMENT_MAX_BYTES=20971520
